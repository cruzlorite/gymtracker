{
  "name": "GymTracker",
  "short_name": "GymTracker",
  "description": "Log every set, rest with a built-in timer and compete with your friends.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F6F3",
